{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node .henriworks/bin/hook.mjs sessionStart || true",
        "powershell": "node .henriworks/bin/hook.mjs sessionStart; exit 0",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node .henriworks/bin/hook.mjs preToolUse || true",
        "powershell": "node .henriworks/bin/hook.mjs preToolUse; exit 0",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node .henriworks/bin/hook.mjs postToolUse || true",
        "powershell": "node .henriworks/bin/hook.mjs postToolUse; exit 0",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "node .henriworks/bin/hook.mjs subagentStart || true",
        "powershell": "node .henriworks/bin/hook.mjs subagentStart; exit 0",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node .henriworks/bin/hook.mjs sessionEnd || true",
        "powershell": "node .henriworks/bin/hook.mjs sessionEnd; exit 0",
        "timeoutSec": 10
      }
    ]
  }
}
